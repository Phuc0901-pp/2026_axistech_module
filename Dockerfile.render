# Multi-stage single-container image for Render Free Tier:
# Runs Python AxisTech Bridge on loopback :8001 + Golang ISO ERP on $PORT

FROM golang:1.23-alpine AS erp-builder
WORKDIR /build
COPY services/erp-platform/go.mod ./
COPY services/erp-platform/cmd ./cmd
COPY services/erp-platform/internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -o /erp-server ./cmd/erp-server

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/axisstream-bridge/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY services/axisstream-bridge/src ./src
COPY --from=erp-builder /erp-server /erp-server
COPY deploy/render_entrypoint.sh /app/render_entrypoint.sh

RUN sed -i 's/\r$//' /app/render_entrypoint.sh && chmod +x /app/render_entrypoint.sh && mkdir -p /data

EXPOSE 10000
ENTRYPOINT ["/app/render_entrypoint.sh"]
