# Production Environment Template (ISO 27001: NEVER commit real secrets or .env.prod)
PUBLIC_DOMAIN=agtech.yourdomain.com

# Database: PostgreSQL 16 (Private Docker Network Only)
POSTGRES_DB=axistech_erp
POSTGRES_USER=agtech_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Service 1: Python AxisTech Bridge
AXISSTREAM_MODE=live
AXISSTREAM_AUTH_MODE=dual
AXISSTREAM_V2_BASE_URL=https://v2.api.axisstream.co
AXISSTREAM_DATA_BASE_URL=https://data.api.axisstream.co
AXISSTREAM_PROVIDER_BASE_URL=https://provider.api.axisstream.co
AXISSTREAM_ALLOWED_HOST_SUFFIX=.axisstream.co
AXISSTREAM_AXISSTREAM_USERNAME=CHANGE_ME_EMAIL
AXISSTREAM_AXISSTREAM_PASSWORD=CHANGE_ME_PASSWORD
AXISSTREAM_AXISSTREAM_EXCHANGE_TOKEN=CHANGE_ME_EXCHANGE_TOKEN
AXISSTREAM_INBOUND_API_KEY=CHANGE_ME_BRIDGE_API_KEY
AXISSTREAM_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
AXISSTREAM_ENCRYPTION_KEY=CHANGE_ME_AEAD_KEY
AXISSTREAM_SYNC_INTERVAL_SEC=15
AXISSTREAM_SQLITE_PATH=/data/bridge_state.db
AXISSTREAM_LOCAL_TIMEZONE=Asia/Ho_Chi_Minh
AXISSTREAM_LOG_LEVEL=INFO

# Service 2: Golang ISO ERP Platform
ERP_PORT=8080
BRIDGE_BASE_URL=http://axisstream-bridge:8001
BRIDGE_API_KEY=CHANGE_ME_BRIDGE_API_KEY
ERP_API_KEY=CHANGE_ME_ERP_API_KEY
ERP_ENCRYPTION_KEY=CHANGE_ME_ERP_AES256GCM_KEY
ERP_REQUIRE_API_KEY=true
ERP_RATE_LIMIT_RPM=300
SYNC_INTERVAL_SEC=10
ERP_DATA_FILE_PATH=/data/erp_state.json
LOG_LEVEL=INFO

# Optional: Only needed when launching `--profile tunnel` with Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_OPTIONAL_TUNNEL_TOKEN
